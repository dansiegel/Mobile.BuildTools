{
  "$schema": "https://mobilebuildtools.com/schemas/v2/buildtools.schema.json",
  "manifests": {
    "token": "$$",
    "variablePrefix": "Manifest_",
    "missingTokensAsErrors": true,
    "disable": false
  },
  "environment": {
    "defaults": {
      "MBTPackageName": "com.avantipoint.mobilebuildtools.appmanifests",
      "AppDisplayName": "MBT AppManifests",
      "UsesCleartextTraffic": "false",
      "ApiHost": "api.example.com"
    },
    "configuration": {
      "Debug": {
        "MBTPackageName": "com.avantipoint.mobilebuildtools.appmanifests.dev",
        "AppDisplayName": "MBT AppManifests Dev",
        "UsesCleartextTraffic": "true",
        "ApiHost": "dev-api.example.com"
      },
      "Release": {
        "MBTPackageName": "com.avantipoint.mobilebuildtools.appmanifests",
        "AppDisplayName": "MBT AppManifests",
        "UsesCleartextTraffic": "false",
        "ApiHost": "api.example.com"
      }
    }
  },
  "debug": true
}
