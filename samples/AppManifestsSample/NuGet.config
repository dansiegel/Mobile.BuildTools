<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="MobileBuildToolsArtifacts" value="../../Artifacts" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="MobileBuildToolsArtifacts">
      <package pattern="Mobile.BuildTools*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
