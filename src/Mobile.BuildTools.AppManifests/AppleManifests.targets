<Project>
  <PropertyGroup>
    <CollectAppManifestsDependsOn>$(CollectAppManifestsDependsOn);_MBTPrepareAppleManifest</CollectAppManifestsDependsOn>
  </PropertyGroup>
  <Target Name="_MBTPrepareAppleManifest" DependsOnTargets="MobileBuildToolsInit;_DetectAppManifest"
          Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <PropertyGroup>
      <_MBTAppleSourceManifest>$(AppBundleManifest)</_MBTAppleSourceManifest>
      <_MBTAppleSourceManifest Condition="'$(_MBTAppleSourceManifest)' == ''">$(_AppManifest)</_MBTAppleSourceManifest>
    </PropertyGroup>
    <TransformManifestItemsTask ConfigurationPath="$(BuildToolsConfigFilePath)"
                                ProjectName="$(MSBuildProjectName)"
                                ProjectDirectory="$(MSBuildProjectDirectory)"
                                SolutionDirectory="$(SolutionDir)"
                                Configuration="$(Configuration)"
                                IntermediateOutputPath="$(IntermediateOutputPath)"
                                TargetFrameworkIdentifier="$(TargetFramework)"
                                Manifests="$(_MBTAppleSourceManifest)"
                                OutputDirectory="$(IntermediateOutputPath)Mobile.BuildTools/manifests/$(TargetFramework)/$(RuntimeIdentifier)/apple"
                                ReplaceTokens="$(BuildToolsEnableTemplateManifests)" VersionManifest="$(BuildToolsEnableAutomaticVersioning)" Condition="Exists('$(_MBTAppleSourceManifest)') And ('$(BuildToolsEnableTemplateManifests)' == 'true' Or '$(BuildToolsEnableAutomaticVersioning)' == 'true')">
      <Output TaskParameter="ProcessedManifests" ItemName="_MBTAppleManifest" />
      <Output TaskParameter="GeneratedFiles" ItemName="FileWrites" />
    </TransformManifestItemsTask>
    <PropertyGroup Condition="'@(_MBTAppleManifest)' != ''">
      <AppBundleManifest>@(_MBTAppleManifest)</AppBundleManifest>
      <_AppManifest>@(_MBTAppleManifest)</_AppManifest>
    </PropertyGroup>
  </Target>
  <!-- BeforeTargets runs after the collection dependencies, including MAUI/Uno splash and font partials. Preserve every item and its metadata. -->
  <Target Name="_MBTPrepareApplePartialManifests" BeforeTargets="CollectAppManifests"
          DependsOnTargets="_MBTPrepareAppleManifest"
          Condition="'$(IsCrossTargetingBuild)' != 'true' And '$(BuildToolsEnableTemplateManifests)' == 'true' And '@(PartialAppManifest)' != ''">
    <TransformManifestItemsTask ConfigurationPath="$(BuildToolsConfigFilePath)"
                                ProjectName="$(MSBuildProjectName)"
                                ProjectDirectory="$(MSBuildProjectDirectory)"
                                SolutionDirectory="$(SolutionDir)"
                                Configuration="$(Configuration)"
                                IntermediateOutputPath="$(IntermediateOutputPath)"
                                TargetFrameworkIdentifier="$(TargetFramework)"
                                Manifests="@(PartialAppManifest)"
                                OutputDirectory="$(IntermediateOutputPath)Mobile.BuildTools/manifests/$(TargetFramework)/$(RuntimeIdentifier)/apple-partials"
                                ReplaceTokens="$(BuildToolsEnableTemplateManifests)" ApplyPackageName="false">
      <Output TaskParameter="ProcessedManifests" ItemName="_MBTApplePartialManifests" />
      <Output TaskParameter="GeneratedFiles" ItemName="FileWrites" />
    </TransformManifestItemsTask>
    <ItemGroup>
      <PartialAppManifest Remove="@(PartialAppManifest)" />
      <PartialAppManifest Include="@(_MBTApplePartialManifests)" />
    </ItemGroup>
  </Target>
</Project>
