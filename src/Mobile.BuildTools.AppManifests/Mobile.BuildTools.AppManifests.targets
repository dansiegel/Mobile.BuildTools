<?xml version="1.0" encoding="utf-8" ?>
<Project>
  <PropertyGroup>
    <_MobileBuildToolsAppManifestTasksDll>$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'Mobile.BuildTools.AppManifests.dll'))</_MobileBuildToolsAppManifestTasksDll>
    <_MobileBuildToolsTargetPlatform>$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</_MobileBuildToolsTargetPlatform>
  </PropertyGroup>

  <UsingTask TaskName="Mobile.BuildTools.Tasks.AutomaticBuildVersioningTask"
             AssemblyFile="$(_MobileBuildToolsAppManifestTasksDll)" />
  <UsingTask TaskName="Mobile.BuildTools.Tasks.TemplateManifestTask"
             AssemblyFile="$(_MobileBuildToolsAppManifestTasksDll)" />

  <Import Project="AndroidManifest.targets"
          Condition=" '$(_MobileBuildToolsTargetPlatform)' == 'android' Or '$(TargetFrameworkIdentifier)' == 'MonoAndroid' " />
  <Import Project="AppleManifests.targets"
          Condition=" '$(_MobileBuildToolsTargetPlatform)' == 'ios' Or '$(_MobileBuildToolsTargetPlatform)' == 'macos' Or '$(_MobileBuildToolsTargetPlatform)' == 'maccatalyst' Or '$(TargetFrameworkIdentifier)' == 'Xamarin.iOS' Or '$(TargetFrameworkIdentifier)' == 'Xamarin.Mac' " />

  <Target Name="_TemplateManifestDebug"
          BeforeTargets="HandleTokenizedInfoPlist;HandleAndroidManifest"
          Condition=" '$(MobileBuildToolsDebug)' == 'true' ">
    <Message Text="Checking for Platform Template Configurations to Copy" />
    <Message Text="SdkShortFrameworkIdentifier: '$(_SdkShortFrameworkIdentifier)'" />
    <Message Text="TargetPlatform: '$(_MobileBuildToolsTargetPlatform)'" />
    <Message Text="Token: '$(ManifestToken)'" />
  </Target>
</Project>
