<Project>
  <!-- Run before the Android SDK first reads package identity, rather than replacing its private cached path afterwards. -->
  <Target Name="_MBTPrepareAndroidManifest" BeforeTargets="PrepareForBuild;_GetAndroidPackageName"
          DependsOnTargets="MobileBuildToolsInit"
          Condition="'$(IsCrossTargetingBuild)' != 'true' And Exists('$(AndroidManifest)')">
    <TransformManifestItemsTask ConfigurationPath="$(BuildToolsConfigFilePath)"
                                ProjectName="$(MSBuildProjectName)"
                                ProjectDirectory="$(MSBuildProjectDirectory)"
                                SolutionDirectory="$(SolutionDir)"
                                Configuration="$(Configuration)"
                                IntermediateOutputPath="$(IntermediateOutputPath)"
                                TargetFrameworkIdentifier="$(TargetFramework)"
                                Manifests="$(AndroidManifest)"
                                OutputDirectory="$(IntermediateOutputPath)Mobile.BuildTools/manifests/$(TargetFramework)/$(RuntimeIdentifier)/android"
                                ReplaceTokens="$(BuildToolsEnableTemplateManifests)" VersionManifest="$(BuildToolsEnableAutomaticVersioning)" Condition="'$(BuildToolsEnableTemplateManifests)' == 'true' Or '$(BuildToolsEnableAutomaticVersioning)' == 'true'">
      <Output TaskParameter="ProcessedManifests" ItemName="_MBTAndroidManifest" />
      <Output TaskParameter="GeneratedFiles" ItemName="FileWrites" />
    </TransformManifestItemsTask>
    <PropertyGroup Condition="'@(_MBTAndroidManifest)' != ''">
      <_MBTAndroidManifestPath>@(_MBTAndroidManifest)</_MBTAndroidManifestPath>
      <AndroidManifest>$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)', '$(_MBTAndroidManifestPath)'))</AndroidManifest>
    </PropertyGroup>
  </Target>
</Project>
