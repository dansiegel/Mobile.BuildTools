{
  "$schema": "https://mobilebuildtools.com/schemas/v3/buildtools.schema.json",
  "automaticVersioning": {
    "behavior": "Off",
    "environment": "All",
    "versionOffset": 0
  },
  "images": {
    "directories": [],
    "conditionalDirectories": {},
    "disable": true
  },
  "manifests": {
    "token": "$$",
    "variablePrefix": "Manifest_",
    "missingTokensAsErrors": true
  },
  "appSettings": {
    "E2E.Tests": [
      {
        "prefix": "Test_",
        "accessibility": "Internal",
        "properties": [
          {
            "name": "APlatformProperty",
            "type": "String",
            "defaultValue": "Should Not Be Used",
            "requiredPlatforms": [
              "iOS",
              "Android"
            ]
          },
          {
            "name": "AString",
            "type": "String"
          },
          {
            "name": "AnInt",
            "type": "Int"
          },
          {
            "name": "ADouble",
            "type": "Double"
          },
          {
            "name": "ABool",
            "type": "Bool"
          },
          {
            "name": "AFloat",
            "type": "Float"
          },
          {
            "name": "ADate",
            "type": "DateTime"
          },
          {
            "name": "AStringArray",
            "type": "String",
            "isArray": true
          },
          {
            "name": "AUri",
            "type": "Uri"
          },
          {
            "name": "AppCenterSecret",
            "type": "String",
            "defaultValue": "default"
          },
          {
            "name": "SomeDefaultBool",
            "type": "Bool",
            "defaultValue": "null"
          }
        ]
      }
    ]
  },
  "debug": true,
  "environment": {
    "defaults": {
      "AString": "Hello World!",
      "AnInt": "5",
      "ADouble": "3.14",
      "ABool": "false",
      "AFloat": "4.2",
      "ADate": "January 1, 2020",
      "AStringArray": "Foo;Bar;Baz",
      "AUri": "https://mobilebuildtools.com",
      "Manifest_SmokeLiteral": "Build smoke <&> \"quotes\" 'apostrophes' \\path $& $1 $$NotAToken$$\nsecond line",
      "Manifest_SmokeEmpty": "",
      "Manifest_SmokeKey.+": "literal-key",
      "Manifest_SmokeCount": "42",
      "Manifest_SmokeRatio": "3.25"
    }
  }
}
