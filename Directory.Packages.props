<?xml version="1.0" encoding="utf-8"?>
<Project>
  <ItemGroup>
    <PackageVersion Include="AvantiPoint.CodeGenHelpers" Version="2.0.30-pre" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
    <!-- Keep the MSBuild 17.10 host contract; take servicing fixes within that line. -->
    <PackageVersion Include="Microsoft.Build" Version="17.10.46" />
    <PackageVersion Include="Microsoft.Build.Tasks.Core" Version="17.10.46" />
    <!-- Generators run inside the consumer compiler; retain the Roslyn 4.10 minimum host. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" Version="1.1.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Newtonsoft.Json.Schema" Version="4.0.2" />
    <!-- 1.3.1 is the latest MIT release; newer versions require a licensing decision. -->
    <PackageVersion Include="NuGetizer" Version="1.3.1" />
    <PackageVersion Include="Microsoft.Web.Xdt" Version="3.2.12" />
    <PackageVersion Include="Fizzler" Version="1.3.1" />
    <PackageVersion Include="HarfBuzzSharp" Version="14.2.1.301" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.1.301" />
    <PackageVersion Include="PolySharp" Version="1.16.0" />
    <PackageVersion Include="ShimSkiaSharp" Version="5.2.3" />
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
    <PackageVersion Include="SkiaSharp.HarfBuzz" Version="4.153.1" />
    <!-- Test-only pixel-parity oracle; never referenced by shipped task projects. -->
    <PackageVersion Include="Svg.Skia" Version="5.2.3" />
    <PackageVersion Include="Svg.Custom" Version="5.2.3" />
    <PackageVersion Include="Svg.Model" Version="5.2.3" />
    <PackageVersion Include="Svg.SceneGraph" Version="5.2.3" />
    <PackageVersion Include="System.Buffers" Version="4.6.1" />
    <PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.12" />
    <PackageVersion Include="System.IO.UnmanagedMemoryStream" Version="4.3.0" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Numerics.Vectors" Version="4.6.1" />
    <PackageVersion Include="System.ObjectModel" Version="4.3.0" />
    <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageVersion Include="System.Text.Json" Version="10.0.12" />
    <PackageVersion Include="McMaster.Extensions.CommandLineUtils" Version="5.1.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Prism 9 changes licensing; keep the current license until explicitly approved. -->
    <PackageVersion Include="Prism.DryIoc.Forms" Version="8.1.97" />
    <PackageVersion Include="Xamarin.Forms" Version="5.0.0.2662" />
    <PackageVersion Include="Xamarin.Forms.Mocks" Version="4.7.0.1" />
    <PackageVersion Include="Xamarin.Essentials" Version="1.8.1" />
    <PackageVersion Include="Microsoft.NETCore.UniversalWindowsPlatform" Version="6.2.14" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- Xamarin.UITest uses the NUnit 3 engine and classic assertion API. -->
    <PackageVersion Include="NUnit" Version="3.14.0" />
    <PackageVersion Include="Xamarin.UITest" Version="4.4.2" />
  </ItemGroup>
  <!-- Consumed only by the native resizetizer integration tests. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Maui.Resizetizer" Version="10.0.110" />
    <PackageVersion Include="Uno.Resizetizer" Version="1.12.7" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>
</Project>
